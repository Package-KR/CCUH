{
  "name": "ccuh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A companion skill for Codex Computer Use that helps locate UI targets, verify actions, and recover from failures with fewer retries and less waiting.",
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "darwin"
  ],
  "scripts": {
    "start": "node src/server.ts",
    "status": "node src/cli.ts status",
    "recent": "node src/cli.ts recent",
    "typecheck": "tsc --noEmit",
    "test:core": "node --test tests/events.test.ts tests/hooks.test.ts tests/diagnostics.test.ts",
    "test:mcp": "node --test tests/mcp.test.ts",
    "test": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
