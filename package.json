{
  "name": "ccuh",
  "version": "0.1.4",
  "license": "MIT",
  "private": true,
  "type": "module",
  "description": "A macOS companion for reliable app and window targeting in Codex Computer Use.",
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "darwin"
  ],
  "bin": {
    "ccuh": "bin/ccuh.mjs"
  },
  "files": [
    ".codex-plugin/",
    "bin/",
    "dist/",
    "hooks/pretooluse.mjs",
    "hooks/posttooluse.mjs",
    "scripts/plugin-runtime.mjs",
    "scripts/plugin-state.mjs",
    "skills/",
    "start.mjs",
    "LICENSE",
    "README.md",
    "README.ko.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "start": "node src/server.ts",
    "status": "node src/cli.ts status",
    "recent": "node src/cli.ts recent",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
