{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__cua_repl__js",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "ccuh",
            "tool": "ccuh_observe_event",
            "input": {
              "event": {
                "hook_event_name": "PreToolUse",
                "session_id": "${session_id}",
                "tool_use_id": "${tool_use_id}",
                "tool_name": "${tool_name}"
              }
            },
            "timeout": 3,
            "statusMessage": "CCUH: recording tool event"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__cua_repl__js",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "ccuh",
            "tool": "ccuh_observe_event",
            "input": {
              "event": {
                "hook_event_name": "PostToolUse",
                "session_id": "${session_id}",
                "tool_use_id": "${tool_use_id}",
                "tool_name": "${tool_name}"
              }
            },
            "timeout": 3,
            "statusMessage": "CCUH: recording tool event"
          }
        ]
      }
    ]
  }
}
