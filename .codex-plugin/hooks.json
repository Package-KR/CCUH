{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^mcp__cua_repl__(?:js|js_reset)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/ccuh-hook\" PreToolUse",
            "timeout": 3,
            "statusMessage": "CCUH: recording Computer Use invocation"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__cua_repl__(?:js|js_reset)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/bin/ccuh-hook\" PostToolUse",
            "timeout": 3,
            "statusMessage": "CCUH: recording Computer Use return"
          }
        ]
      }
    ]
  }
}
