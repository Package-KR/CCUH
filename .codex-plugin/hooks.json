{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "(?:^|[_.:-])(?:cua_repl|computer_use)(?:[_.:-]|$)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/pretooluse.mjs\"",
            "timeout": 3,
            "statusMessage": "CCUH: observing Computer Use metadata"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(?:^|[_.:-])(?:cua_repl|computer_use)(?:[_.:-]|$)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/posttooluse.mjs\"",
            "timeout": 3,
            "statusMessage": "CCUH: observing Computer Use metadata"
          }
        ]
      }
    ]
  }
}
